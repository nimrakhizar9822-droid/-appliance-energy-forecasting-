      <pre class="editor flex monaco monaco-colorized colab colab" contenteditable="true" data-lang="notebook-python"><span><span class="mtk1">TEST_DAYS&nbsp;=&nbsp;</span><span class="mtk12">14</span></span><br><span><span class="mtk1">test_period&nbsp;=&nbsp;features.iloc[-TEST_DAYS&nbsp;*&nbsp;</span><span class="mtk12">24</span><span class="mtk1">:]</span></span><br><span><span class="mtk1">train_period&nbsp;=&nbsp;features.iloc[:-TEST_DAYS&nbsp;*&nbsp;</span><span class="mtk12">24</span><span class="mtk1">]</span></span><br><span><span></span></span><br><span><span class="mtk1">feature_cols&nbsp;=&nbsp;[c&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;c&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;features.columns&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;c&nbsp;!=&nbsp;</span><span class="mtk21">'Appliances'</span><span class="mtk1">]</span></span><br><span><span class="mtk1">X_train,&nbsp;y_train&nbsp;=&nbsp;train_period[feature_cols],&nbsp;tra</span><span class="mtk1">in_period[</span><span class="mtk21">'Appliances'</span><span class="mtk1">]</span></span><br><span><span class="mtk1">X_test,&nbsp;y_test&nbsp;=&nbsp;test_period[feature_cols],&nbsp;test_p</span><span class="mtk1">eriod[</span><span class="mtk21">'Appliances'</span><span class="mtk1">]</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">'Train:'</span><span class="mtk1">,&nbsp;X_train.shape,&nbsp;</span><span class="mtk21">'&nbsp;Test&nbsp;(14&nbsp;days):'</span><span class="mtk1">,&nbsp;X_test.shape)</span></span><br><span><span></span></span><br><span><span class="mtk1">xgb_model&nbsp;=&nbsp;XGBRegressor(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n_estimators=</span><span class="mtk12">400</span><span class="mtk1">,&nbsp;max_depth=</span><span class="mtk12">5</span><span class="mtk1">,&nbsp;learning_rate=</span><span class="mtk12">0.03</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;subsample=</span><span class="mtk12">0.8</span><span class="mtk1">,&nbsp;colsample_bytree=</span><span class="mtk12">0.8</span><span class="mtk1">,&nbsp;random_state=RANDOM_STATE</span></span><br><span><span class="mtk1">)</span></span><br><span><span class="mtk1">xgb_model.fit(X_train,&nbsp;y_train)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;NOTE:&nbsp;the&nbsp;weather/indoor-sensor&nbsp;covariates&nbsp;for&nbsp;t</span><span class="mtk8">he&nbsp;test&nbsp;window&nbsp;use&nbsp;their&nbsp;ACTUAL</span></span><br><span><span class="mtk8">#&nbsp;observed&nbsp;values&nbsp;(not&nbsp;independently&nbsp;forecast).&nbsp;Th</span><span class="mtk8">is&nbsp;means&nbsp;the&nbsp;XGBoost&nbsp;forecast&nbsp;below&nbsp;is</span></span><br><span><span class="mtk8">#&nbsp;a&nbsp;CONDITIONAL&nbsp;forecast&nbsp;--&nbsp;it&nbsp;assumes&nbsp;perfect&nbsp;kno</span><span class="mtk8">wledge&nbsp;of&nbsp;future&nbsp;exogenous&nbsp;inputs&nbsp;--&nbsp;not</span></span><br><span><span class="mtk8">#&nbsp;a&nbsp;true&nbsp;operational&nbsp;forecast.&nbsp;This&nbsp;limitation&nbsp;is&nbsp;</span><span class="mtk8">discussed&nbsp;explicitly&nbsp;in&nbsp;the&nbsp;report&nbsp;(Q5).</span></span><br><span><span class="mtk1">xgb_pred_test&nbsp;=&nbsp;xgb_model.predict(X_test)</span></span><br><span><span></span></span><br><span><span class="mtk1">xgb_metrics_14day&nbsp;=&nbsp;evaluate(y_test,&nbsp;xgb_pred_test</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">'XGBoost&nbsp;metrics&nbsp;(full&nbsp;14-day&nbsp;test&nbsp;period):'</span><span class="mtk1">,&nbsp;xgb_metrics_14day)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Also&nbsp;report&nbsp;the&nbsp;final&nbsp;24h&nbsp;subset&nbsp;so&nbsp;it&nbsp;is&nbsp;direct</span><span class="mtk8">ly&nbsp;comparable&nbsp;to&nbsp;the&nbsp;other&nbsp;models</span></span><br><span><span class="mtk1">xgb_last24_actual&nbsp;=&nbsp;y_test.iloc[</span><span class="mtk12">-24</span><span class="mtk1">:]</span></span><br><span><span class="mtk1">xgb_last24_pred&nbsp;=&nbsp;xgb_pred_test[</span><span class="mtk12">-24</span><span class="mtk1">:]</span></span><br><span><span class="mtk1">xgb_metrics_last24&nbsp;=&nbsp;evaluate(xgb_last24_actual,&nbsp;x</span><span class="mtk1">gb_last24_pred)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">'XGBoost&nbsp;metrics&nbsp;(last&nbsp;24h,&nbsp;for&nbsp;cross-model&nbsp;compar</span><span class="mtk21">ison):'</span><span class="mtk1">,&nbsp;xgb_metrics_last24)</span></span><br><span><span></span></span><br></pre><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
