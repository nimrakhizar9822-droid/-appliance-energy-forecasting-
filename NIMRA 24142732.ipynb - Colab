      <pre class="editor flex monaco monaco-colorized colab colab" contenteditable="true" data-lang="notebook-python"><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">build_features</span><span class="mtk1">(</span><span class="mtk16">df</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Engineer&nbsp;time-based,&nbsp;lag,&nbsp;and&nbsp;rolling-window&nbsp;fe</span><span class="mtk21">atures&nbsp;on&nbsp;top&nbsp;of&nbsp;the&nbsp;raw</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;sensor/weather&nbsp;covariates&nbsp;already&nbsp;present&nbsp;in&nbsp;t</span><span class="mtk21">he&nbsp;dataset.</span></span><br><span><span></span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;Parameters</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;----------</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;df&nbsp;:&nbsp;pd.DataFrame</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Hourly-resampled&nbsp;dataframe&nbsp;containing&nbsp;'App</span><span class="mtk21">liances'&nbsp;and&nbsp;the&nbsp;raw&nbsp;sensor&nbsp;columns.</span></span><br><span><span></span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;Returns</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;-------</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;pd.DataFrame</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Dataframe&nbsp;with&nbsp;additional&nbsp;engineered&nbsp;featu</span><span class="mtk21">re&nbsp;columns&nbsp;(rows&nbsp;with&nbsp;NaNs&nbsp;from</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;lagging/rolling&nbsp;are&nbsp;NOT&nbsp;dropped&nbsp;here&nbsp;--&nbsp;dr</span><span class="mtk21">op&nbsp;them&nbsp;after&nbsp;calling&nbsp;this&nbsp;function).</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;"""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out&nbsp;=&nbsp;df.copy()</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;---&nbsp;Time-based&nbsp;features&nbsp;---</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'hour'</span><span class="mtk1">]&nbsp;=&nbsp;out.index.hour</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'dayofweek'</span><span class="mtk1">]&nbsp;=&nbsp;out.index.dayofweek</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'is_weekend'</span><span class="mtk1">]&nbsp;=&nbsp;(out[</span><span class="mtk21">'dayofweek'</span><span class="mtk1">]&nbsp;&gt;=&nbsp;</span><span class="mtk12">5</span><span class="mtk1">).astype(</span><span class="mtk14">int</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;cyclic&nbsp;encodings&nbsp;so&nbsp;the&nbsp;model&nbsp;sees&nbsp;hour&nbsp;23&nbsp;and&nbsp;h</span><span class="mtk8">our&nbsp;0&nbsp;as&nbsp;close&nbsp;together</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'hour_sin'</span><span class="mtk1">]&nbsp;=&nbsp;np.sin(</span><span class="mtk12">2</span><span class="mtk1">&nbsp;*&nbsp;np.pi&nbsp;*&nbsp;out[</span><span class="mtk21">'hour'</span><span class="mtk1">]&nbsp;/&nbsp;</span><span class="mtk12">24</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'hour_cos'</span><span class="mtk1">]&nbsp;=&nbsp;np.cos(</span><span class="mtk12">2</span><span class="mtk1">&nbsp;*&nbsp;np.pi&nbsp;*&nbsp;out[</span><span class="mtk21">'hour'</span><span class="mtk1">]&nbsp;/&nbsp;</span><span class="mtk12">24</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'dow_sin'</span><span class="mtk1">]&nbsp;=&nbsp;np.sin(</span><span class="mtk12">2</span><span class="mtk1">&nbsp;*&nbsp;np.pi&nbsp;*&nbsp;out[</span><span class="mtk21">'dayofweek'</span><span class="mtk1">]&nbsp;/&nbsp;</span><span class="mtk12">7</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'dow_cos'</span><span class="mtk1">]&nbsp;=&nbsp;np.cos(</span><span class="mtk12">2</span><span class="mtk1">&nbsp;*&nbsp;np.pi&nbsp;*&nbsp;out[</span><span class="mtk21">'dayofweek'</span><span class="mtk1">]&nbsp;/&nbsp;</span><span class="mtk12">7</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;---&nbsp;Lagged&nbsp;appliance-use&nbsp;features&nbsp;(1h,&nbsp;2h,&nbsp;3h,&nbsp;1</span><span class="mtk8">&nbsp;day,&nbsp;2&nbsp;days,&nbsp;1&nbsp;week)&nbsp;---</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;lag&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;[</span><span class="mtk12">1</span><span class="mtk1">,&nbsp;</span><span class="mtk12">2</span><span class="mtk1">,&nbsp;</span><span class="mtk12">3</span><span class="mtk1">,&nbsp;</span><span class="mtk12">24</span><span class="mtk1">,&nbsp;</span><span class="mtk12">48</span><span class="mtk1">,&nbsp;</span><span class="mtk12">168</span><span class="mtk1">]:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk6">f</span><span class="mtk21">'Appliances_lag</span><span class="mtk1">{lag}</span><span class="mtk21">'</span><span class="mtk1">]&nbsp;=&nbsp;out[</span><span class="mtk21">'Appliances'</span><span class="mtk1">].shift(lag)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;---&nbsp;Rolling&nbsp;statistics&nbsp;(shifted&nbsp;by&nbsp;1&nbsp;so&nbsp;the&nbsp;curr</span><span class="mtk8">ent&nbsp;row's&nbsp;own&nbsp;value&nbsp;is&nbsp;not&nbsp;leaked)&nbsp;---</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'Appliances_roll_mean_24h'</span><span class="mtk1">]&nbsp;=&nbsp;out[</span><span class="mtk21">'Appliances'</span><span class="mtk1">].shift(</span><span class="mtk12">1</span><span class="mtk1">).rolling(</span><span class="mtk12">24</span><span class="mtk1">).mean()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'Appliances_roll_std_24h'</span><span class="mtk1">]&nbsp;=&nbsp;out[</span><span class="mtk21">'Appliances'</span><span class="mtk1">].shift(</span><span class="mtk12">1</span><span class="mtk1">).rolling(</span><span class="mtk12">24</span><span class="mtk1">).std()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;out[</span><span class="mtk21">'Appliances_roll_mean_168h'</span><span class="mtk1">]&nbsp;=&nbsp;out[</span><span class="mtk21">'Appliances'</span><span class="mtk1">].shift(</span><span class="mtk12">1</span><span class="mtk1">).rolling(</span><span class="mtk12">168</span><span class="mtk1">).mean()</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Sensor/weather&nbsp;covariates&nbsp;already&nbsp;present&nbsp;in&nbsp;the</span><span class="mtk8">&nbsp;raw&nbsp;dataset&nbsp;(T1-T9&nbsp;indoor&nbsp;temps,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;RH_1-RH_9&nbsp;indoor&nbsp;humidity,&nbsp;T_out,&nbsp;RH_out,&nbsp;Press_</span><span class="mtk8">mm_hg,&nbsp;Windspeed,&nbsp;Visibility,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Tdewpoint)&nbsp;are&nbsp;kept&nbsp;as-is&nbsp;--&nbsp;no&nbsp;further&nbsp;engineer</span><span class="mtk8">ing&nbsp;needed&nbsp;for&nbsp;these.</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;out</span></span><br><span><span></span></span><br><span><span class="mtk1">features&nbsp;=&nbsp;build_features(hourly).dropna()</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">'Feature&nbsp;matrix&nbsp;shape&nbsp;(after&nbsp;dropping&nbsp;NaNs&nbsp;from&nbsp;la</span><span class="mtk21">gging):'</span><span class="mtk1">,&nbsp;features.shape)</span></span><br><span><span class="mtk1">features.head()</span></span><br><span><span></span></span><br></pre><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
