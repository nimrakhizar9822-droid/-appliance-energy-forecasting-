pan class="mtk12">4</span><span class="mtk1">))</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;ax.plot(test.index,&nbsp;test.values,&nbsp;label=</span><span class="mtk21">'Actual'</span><span class="mtk1">,&nbsp;color=</span><span class="mtk21">'black'</span><span class="mtk1">,&nbsp;marker=</span><span class="mtk21">'o'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;ax.plot(test.index,&nbsp;chronos_median,&nbsp;label=</span><span class="mtk21">'Chronos-Bolt&nbsp;median&nbsp;forecast'</span><span class="mtk1">,&nbsp;linestyle=</span><span class="mtk21">'--'</span><span class="mtk1">,&nbsp;color=</span><span class="mtk21">'tab:green'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;ax.fill_between(test.index,&nbsp;chronos_lower,&nbsp;chr</span><span class="mtk1">onos_upper,&nbsp;alpha=</span><span class="mtk12">0.2</span><span class="mtk1">,&nbsp;color=</span><span class="mtk21">'tab:green'</span><span class="mtk1">,&nbsp;label=</span><span class="mtk21">'80%&nbsp;interval'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;ax.legend();&nbsp;ax.set_title(</span><span class="mtk21">'Chronos-Bolt&nbsp;Zero-Shot&nbsp;Forecast&nbsp;vs&nbsp;Actual'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;plt.xticks(rotation=</span><span class="mtk12">30</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;plt.tight_layout()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;plt.show()</span></span><br><span><span class="mtk19">else</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">'RUN_CHRONOS&nbsp;is&nbsp;False&nbsp;--&nbsp;skipping&nbsp;(no&nbsp;internet&nbsp;acc</span><span class="mtk21">ess&nbsp;in&nbsp;