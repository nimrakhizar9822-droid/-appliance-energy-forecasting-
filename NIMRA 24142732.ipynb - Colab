      <pre class="editor flex monaco monaco-colorized colab colab" contenteditable="true" data-lang="notebook-python"><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">mean_forecast</span><span class="mtk1">(</span><span class="mtk16">train_series</span><span class="mtk1">,&nbsp;</span><span class="mtk16">horizon</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Forecast&nbsp;every&nbsp;future&nbsp;step&nbsp;as&nbsp;the&nbsp;historical&nbsp;me</span><span class="mtk21">an."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;np.full(horizon,&nbsp;train_series.mean())</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">naive_forecast</span><span class="mtk1">(</span><span class="mtk16">train_series</span><span class="mtk1">,&nbsp;</span><span class="mtk16">horizon</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Forecast&nbsp;every&nbsp;future&nbsp;step&nbsp;as&nbsp;the&nbsp;last&nbsp;observed</span><span class="mtk21">&nbsp;value."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;np.full(horizon,&nbsp;train_series.iloc[</span><span class="mtk12">-1</span><span class="mtk1">])</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">seasonal_naive_forecast</span><span class="mtk1">(</span><span class="mtk16">train_series</span><span class="mtk1">,&nbsp;</span><span class="mtk16">horizon</span><span class="mtk1">,&nbsp;</span><span class="mtk16">season_length</span><span class="mtk1">=</span><span class="mtk12">24</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Forecast&nbsp;each&nbsp;future&nbsp;step&nbsp;as&nbsp;the&nbsp;value&nbsp;exactly&nbsp;</span><span class="mtk21">one&nbsp;season&nbsp;(24h)&nbsp;earlier."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;train_series.iloc[-season_length:].values[:horizo</span><span class="mtk1">n]</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">weekly_seasonal_naive_forecast</span><span class="mtk1">(</span><span class="mtk16">train_series</span><span class="mtk1">,&nbsp;</span><span class="mtk16">horizon</span><span class="mtk1">,&nbsp;</span><span class="mtk16">season_length</span><span class="mtk1">=</span><span class="mtk12">168</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Forecast&nbsp;each&nbsp;future&nbsp;step&nbsp;as&nbsp;the&nbsp;value&nbsp;exactly&nbsp;</span><span class="mtk21">one&nbsp;week&nbsp;(168h)&nbsp;earlier."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;train_series.iloc[-season_length:].values[:horizo</span><span class="mtk1">n]</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">drift_forecast</span><span class="mtk1">(</span><span class="mtk16">train_series</span><span class="mtk1">,&nbsp;</span><span class="mtk16">horizon</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Extrapolate&nbsp;a&nbsp;straight&nbsp;line&nbsp;through&nbsp;the&nbsp;first&nbsp;a</span><span class="mtk21">nd&nbsp;last&nbsp;training&nbsp;points."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n&nbsp;=&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(train_series)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;slope&nbsp;=&nbsp;(train_series.iloc[</span><span class="mtk12">-1</span><span class="mtk1">]&nbsp;-&nbsp;train_series.iloc[</span><span class="mtk12">0</span><span class="mtk1">])&nbsp;/&nbsp;(n&nbsp;-&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;train_series.iloc[</span><span class="mtk12">-1</span><span class="mtk1">]&nbsp;+&nbsp;slope&nbsp;*&nbsp;np.arange(</span><span class="mtk12">1</span><span class="mtk1">,&nbsp;horizon&nbsp;+&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">benchmark_forecasts&nbsp;=&nbsp;{</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">'Mean'</span><span class="mtk1">:&nbsp;mean_forecast(train,&nbsp;HORIZON),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">'Naive'</span><span class="mtk1">:&nbsp;naive_forecast(train,&nbsp;HORIZON),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">'Seasonal&nbsp;Naive&nbsp;(24h)'</span><span class="mtk1">:&nbsp;seasonal_naive_forecast(train,&nbsp;HORIZON),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">'Seasonal&nbsp;Naive&nbsp;(168h/weekly)'</span><span class="mtk1">:&nbsp;weekly_seasonal_naive_forecast(train,&nbsp;HORIZON),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">'Drift'</span><span class="mtk1">:&nbsp;drift_forecast(train,&nbsp;HORIZON),</span></span><br><span><span class="mtk1">}</span></span><br><span><span></span></span><br><span><span class="mtk1">benchmark_metrics&nbsp;=&nbsp;pd.DataFrame([</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;{</span><span class="mtk21">'Model'</span><span class="mtk1">:&nbsp;name,&nbsp;**evaluate(test,&nbsp;fc)}&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;name,&nbsp;fc&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;benchmark_forecasts.items()</span></span><br><span><span class="mtk1">]).sort_values(</span><span class="mtk21">'RMSE'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">benchmark_metrics</span></span><br></pre><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
