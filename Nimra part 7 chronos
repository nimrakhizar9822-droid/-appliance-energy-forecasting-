      "source": [
        "pipeline = BaseChronosPipeline.from_pretrained(\n",
        "    \"amazon/chronos-bolt-base\",\n",
        "    device_map=\"cuda\" if torch.cuda.is_available() else \"cpu\",\n",
        "    torch_dtype=torch.float32,   # T4 GPUs don't fully support bfloat16 -> use float32\n",
        ")\n",
        "\n",
        "context = torch.tensor(train.values, dtype=torch.float32)\n",
        "quantiles, mean = pipeline.predict_quantiles(\n",
        "    context,   # positional — some chronos-forecasting versions call this \"context\", others \"inputs\"\n",
        "    prediction_length=FORECAST_HORIZON,\n",
        "    quantile_levels=[0.1, 0.5, 0.9],\n",
        ")\n",
        "preds = mean[0].numpy()\n",
        "q10 = quantiles[0, :, 0].numpy()\n",
        "q90 = quantiles[0, :, 2].numpy()\n",
        "\n",
        "# --- safety check: catch a short/garbled forecast immediately instead of\n",
        "# silently computing metrics on the wrong number of points ---\n",
        "print(\"quantiles shape:\", quantiles.shape, \" mean shape:\", mean.shape)\n",
        "print(\"preds length:\", len(preds), \" (should equal FORECAST_HORIZON =\", FORECAST_HORIZON, \")\")\n",
        "assert len(preds) == FORECAST_HORIZON, (\n",
        "    f\"Got {len(preds)} predictions, expected {FORECAST_HORIZON}. \"\n",
        "    \"Restart the runtime (Runtime -> Restart session) and re-run all cells top to bottom \"\n",
        "    \"-- this usually means a stale variable from an earlier partial run.\"\n",
        ")\n",
        "print(\"Forecast generated for next\", FORECAST_HORIZON, \"hours.\")"
      ]
    },
