      <pre class="editor flex monaco monaco-colorized colab colab" contenteditable="true" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;!pip&nbsp;install&nbsp;chronos-forecasting&nbsp;--quiet&nbsp;&nbsp;&nbsp;#&nbsp;unc</span><span class="mtk8">omment&nbsp;on&nbsp;first&nbsp;run&nbsp;in&nbsp;Colab</span></span><br><span><span></span></span><br><span><span class="mtk1">RUN_CHRONOS&nbsp;=&nbsp;</span><span class="mtk6">False</span><span class="mtk1">&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;set&nbsp;True&nbsp;when&nbsp;running&nbsp;in&nbsp;an&nbsp;environment&nbsp;with&nbsp;int</span><span class="mtk8">ernet&nbsp;access</span></span><br><span><span></span></span><br><span><span class="mtk19">if</span><span class="mtk1">&nbsp;RUN_CHRONOS:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">from</span><span class="mtk1">&nbsp;chronos&nbsp;</span><span class="mtk19">import</span><span class="mtk1">&nbsp;ChronosBoltPipeline</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;pipeline&nbsp;=&nbsp;ChronosBoltPipeline.from_pretrained</span><span class="mtk1">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"amazon/chronos-bolt-base"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;device_map=</span><span class="mtk21">"cpu"</span><span class="mtk1">,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;switch&nbsp;to&nbsp;"cuda"&nbsp;if&nbsp;a&nbsp;GPU&nbsp;runtime&nbsp;is&nbsp;available</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;torch_dtype=torch.float32,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;context&nbsp;=&nbsp;torch.tensor