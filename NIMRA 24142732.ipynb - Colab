      <pre class="editor flex monaco monaco-colorized colab colab" contenteditable="true" data-lang="notebook-python"><span><span class="mtk1">LOOKBACK&nbsp;=&nbsp;</span><span class="mtk12">48</span><span class="mtk1">&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;hours&nbsp;of&nbsp;history&nbsp;used&nbsp;to&nbsp;predict&nbsp;the&nbsp;next&nbsp;hour</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">make_sequences</span><span class="mtk1">(</span><span class="mtk16">series_2d</span><span class="mtk1">,&nbsp;</span><span class="mtk16">lookback</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Convert&nbsp;a&nbsp;scaled&nbsp;1D&nbsp;series&nbsp;into&nbsp;(X,&nbsp;y)&nbsp;supervis</span><span class="mtk21">ed-learning&nbsp;sequences&nbsp;for&nbsp;the&nbsp;LSTM."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X,&nbsp;Y&nbsp;=&nbsp;[],&nbsp;[]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;i&nbsp;</span><span class="mtk6">in</span><span class="mtk1"> </span><span class="mtk15">range</span><span class="mtk1">(lookback,&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(series_2d)):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;X.append(series_2d[i&nbsp;-&nbsp;lookback:i,&nbsp;</span><span class="mtk12">0</span><span class="mtk1">])</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Y.append(series_2d[i,&nbsp;</span><span class="mtk12">0</span><span class="mtk1">])</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;np.array(X),&nbsp;np.array(Y)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk6">class</span><span class="mtk1"> </span><span class="mtk14">LSTMForecaster</span><span class="mtk1">(</span><span class="mtk14">nn</span><span class="mtk1">.</span><span class="mtk14">Module</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Single-layer&nbsp;LSTM&nbsp;regressor&nbsp;for&nbsp;one-step-ahead&nbsp;</span><span class="mtk21">appliance&nbsp;energy&nbsp;forecasting."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">__init__</span><span class="mtk1">(</span><span class="mtk16">self</span><span class="mtk1">,&nbsp;</span><span class="mtk16">hidden_size</span><span class="mtk1">=</span><span class="mtk12">32</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;super().</span><span class="mtk15">__init__</span><span class="mtk1">()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk16">self</span><span class="mtk1">.lstm&nbsp;=&nbsp;nn.LSTM(input_size=</span><span class="mtk12">1</span><span class="mtk1">,&nbsp;hidden_size=hidden_size,&nbsp;num_layers=</span><span class="mtk12">1</span><span class="mtk1">,&nbsp;batch_first=</span><span class="mtk6">True</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk16">self</span><span class="mtk1">.fc&nbsp;=&nbsp;nn.Linear(hidden_size,&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">forward</span><span class="mtk1">(</span><span class="mtk16">self</span><span class="mtk1">,&nbsp;</span><span class="mtk16">x</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;out,&nbsp;_&nbsp;=&nbsp;</span><span class="mtk16">self</span><span class="mtk1">.lstm(x)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;out&nbsp;=&nbsp;out[:,&nbsp;</span><span class="mtk12">-1</span><span class="mtk1">,&nbsp;:]&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;take&nbsp;the&nbsp;last&nbsp;time&nbsp;step's&nbsp;hidden&nbsp;state</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1"> </span><span class="mtk16">self</span><span class="mtk1">.fc(out)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">train_lstm</span><span class="mtk1">(</span><span class="mtk16">train_series</span><span class="mtk1">,&nbsp;</span><span class="mtk16">horizon</span><span class="mtk1">,&nbsp;</span><span class="mtk16">lookback</span><span class="mtk1">=</span><span class="mtk12">48</span><span class="mtk1">,&nbsp;</span><span class="mtk16">hidden_size</span><span class="mtk1">=</span><span class="mtk12">32</span><span class="mtk1">,&nbsp;</span><span class="mtk16">epochs</span><span class="mtk1">=</span><span class="mtk12">60</span><span class="mtk1">,&nbsp;</span><span class="mtk16">batch_size</span><span class="mtk1">=</span><span class="mtk12">64</span><span class="mtk1">,&nbsp;</span><span class="mtk16">lr</span><span class="mtk1">=</span><span class="mtk12">0.005</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Scale&nbsp;the&nbsp;training&nbsp;series,&nbsp;build&nbsp;sequences,&nbsp;tra</span><span class="mtk21">in&nbsp;an&nbsp;LSTM,&nbsp;and&nbsp;produce&nbsp;a</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;recursive&nbsp;`horizon`-step-ahead&nbsp;forecast."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_arr&nbsp;=&nbsp;train_series.values.reshape(</span><span class="mtk12">-1</span><span class="mtk1">,&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;scaler&nbsp;=&nbsp;MinMaxScaler()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_scaled&nbsp;=&nbsp;scaler.fit_transform(y_arr)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X,&nbsp;Y&nbsp;=&nbsp;make_sequences(y_scaled,&nbsp;lookback)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_t&nbsp;=&nbsp;torch.tensor(X,&nbsp;dtype=torch.float32).uns</span><span class="mtk1">queeze(</span><span class="mtk12">-1</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;Y_t&nbsp;=&nbsp;torch.tensor(Y,&nbsp;dtype=torch.float32).uns</span><span class="mtk1">queeze(</span><span class="mtk12">-1</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;model&nbsp;=&nbsp;LSTMForecaster(hidden_size)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;optimizer&nbsp;=&nbsp;torch.optim.Adam(model.parameters(</span><span class="mtk1">),&nbsp;lr=lr)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;loss_fn&nbsp;=&nbsp;nn.MSELoss()</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n&nbsp;=&nbsp;X_t.shape[</span><span class="mtk12">0</span><span class="mtk1">]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;losses&nbsp;=&nbsp;[]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;epoch&nbsp;</span><span class="mtk6">in</span><span class="mtk1"> </span><span class="mtk15">range</span><span class="mtk1">(epochs):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;perm&nbsp;=&nbsp;torch.randperm(n)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;epoch_loss&nbsp;=&nbsp;</span><span class="mtk12">0.0</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;i&nbsp;</span><span class="mtk6">in</span><span class="mtk1"> </span><span class="mtk15">range</span><span class="mtk1">(</span><span class="mtk12">0</span><span class="mtk1">,&nbsp;n,&nbsp;batch_size):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;idx&nbsp;=&nbsp;perm[i:i&nbsp;+&nbsp;batch_size]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;xb,&nbsp;yb&nbsp;=&nbsp;X_t[idx],&nbsp;Y_t[idx]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;optimizer.zero_grad()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;pred&nbsp;=&nbsp;model(xb)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;loss&nbsp;=&nbsp;loss_fn(pred,&nbsp;yb)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;loss.backward()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;optimizer.step()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;epoch_loss&nbsp;+=&nbsp;loss.item()&nbsp;*&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(idx)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;losses.append(epoch_loss&nbsp;/&nbsp;n)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Recursive&nbsp;forecast:&nbsp;feed&nbsp;each&nbsp;prediction&nbsp;back&nbsp;in</span><span class="mtk8">&nbsp;as&nbsp;the&nbsp;newest&nbsp;point&nbsp;in&nbsp;the&nbsp;window</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;model.</span><span class="mtk15">eval</span><span class="mtk1">()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;window&nbsp;=&nbsp;y_scaled[-lookback:,&nbsp;</span><span class="mtk12">0</span><span class="mtk1">].tolist()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;preds_scaled&nbsp;=&nbsp;[]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">with</span><span class="mtk1">&nbsp;torch.no_grad():</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;_&nbsp;</span><span class="mtk6">in</span><span class="mtk1"> </span><span class="mtk15">range</span><span class="mtk1">(horizon):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;x_in&nbsp;=&nbsp;torch.tensor(window[-lookback:]</span><span class="mtk1">,&nbsp;dtype=torch.float32).view(</span><span class="mtk12">1</span><span class="mtk1">,&nbsp;lookback,&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;p&nbsp;=&nbsp;model(x_in).item()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;preds_scaled.append(p)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;window.append(p)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;preds&nbsp;=&nbsp;scaler.inverse_transform(np.array(pred</span><span class="mtk1">s_scaled).reshape(</span><span class="mtk12">-1</span><span class="mtk1">,&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)).flatten()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;preds,&nbsp;losses,&nbsp;model</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk1">lstm_preds,&nbsp;lstm_losses,&nbsp;lstm_model&nbsp;=&nbsp;train_lstm(t</span><span class="mtk1">rain,&nbsp;HORIZON,&nbsp;lookback=LOOKBACK)</span></span><br><span><span class="mtk1">lstm_metrics&nbsp;=&nbsp;evaluate(test.values,&nbsp;lstm_preds)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">'LSTM&nbsp;test&nbsp;metrics:'</span><span class="mtk1">,&nbsp;lstm_metrics)</span></span><br><span><span></span></span><br></pre><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
